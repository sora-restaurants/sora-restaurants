# Copy to apps/web/.env.local for local work; set the same names in the host's dashboard (Vercel) for production.
# Never commit real values, and never prefix a secret with NEXT_PUBLIC_ (those are sent to the browser).

# Postgres connection used by the server only. Supabase: Project settings > Database > Connection string (transaction pooler).
DATABASE_URL=

# Supabase project, for staff sign-in in the ordering app. Both are safe to expose.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# The site's public address, used for share previews. No trailing slash.
NEXT_PUBLIC_SITE_URL=https://sora-restaurants.vercel.app

# /admin sign-in. Without both, nobody can sign in.
# ADMIN_PASSWORD: 12 characters or more. ADMIN_SESSION_SECRET: 32 or more random characters, e.g. `openssl rand -hex 32`.
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=

# Mixed into the hashed internet address kept with each waitlist application for rate limiting. Any long random string.
WAITLIST_IP_SALT=
