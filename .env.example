# Public application configuration
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-local-anon-key

# Server-only value — use the Supabase transaction pooler URL on Vercel and never expose with NEXT_PUBLIC_
# Append sslmode=require for hosted Supabase. Keep the password only in Supabase/Vercel secret stores.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# Optional observability
LOG_LEVEL=debug

# Optional Vercel Preview only. Use a table in the staging demo database.
DEMO_PAYMENT_TABLE_TOKEN=

# Later integrations; leave unset until selected and approved
PAYMENT_PROVIDER=
PAYMENT_WEBHOOK_SECRET=
POS_PROVIDER=
PRINTER_BRIDGE_SHARED_SECRET=
