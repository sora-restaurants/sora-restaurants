{
  "name": "restaurant-saas",
  "private": true,
  "packageManager": "pnpm@10.18.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter web dev",
    "dev:lan": "pnpm --filter web dev:lan",
    "build": "pnpm --filter web build",
    "test": "vitest run",
    "test:realpg": "vitest run -c vitest.realpg.config.ts",
    "typecheck": "pnpm --filter web typecheck",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "demo": "node scripts/demo.mjs",
    "db:local": "node --experimental-strip-types scripts/local-db.mjs",
    "bench:kitchen": "node --experimental-strip-types scripts/kitchen-index-bench.mjs",
    "demo:isolation": "node scripts/isolation-demo.mjs",
    "demo:pipeline": "node --experimental-strip-types scripts/simulate-order.mjs",
    "simulate:order": "node --experimental-strip-types scripts/simulate-order.mjs --url http://localhost:3000",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.3.11",
    "@playwright/test": "1.56.1",
    "@types/pg": "8.15.5",
    "embedded-postgres": "17.10.0-beta.17",
    "pg": "8.23.1",
    "supabase": "2.54.11",
    "vitest": "3.2.4"
  }
}
